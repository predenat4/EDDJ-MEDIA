rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHardcodedAdmin() {
      return request.auth.token.email in [
        "predenatjeanphenix@gmail.com",
        "stepheclerveaux@gmail.com",
        "chretiensmaptoujouretenegbibla@gmail.com"
      ] && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        isHardcodedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidMedia(data) {
      return data.keys().hasAll(['title', 'type', 'url', 'category', 'createdAt', 'authorUid']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.type in ['photo', 'video', 'audio'] &&
             data.url is string && data.url.size() < 2000000 && // Base64 can be large
             data.category is string && data.category.size() > 0 && data.category.size() < 50 &&
             data.createdAt is string &&
             data.authorUid == request.auth.uid;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.email is string && data.email.size() > 0 &&
             data.role in ['admin', 'user'] &&
             data.createdAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /media/{mediaId} {
      allow read: if true; // Publicly readable
      allow create: if isAdmin() && isValidMedia(request.resource.data);
      allow update: if isAdmin() && isValidMedia(request.resource.data) && 
                      request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Allow users to create their own profile if it doesn't exist, but only with 'user' role
      // Unless they are a hardcoded admin
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUser(request.resource.data) &&
                      (request.resource.data.role == 'user' || isHardcodedAdmin());
      // Only admins can update roles
      allow update: if isAdmin() && isValidUser(request.resource.data);
    }
  }
}
